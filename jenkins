pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        git 'https://github.com/Danujaf/ci-cd-tutorial-sample-app.git'
      }
    }

    stage('Install Dependencies') {
      steps {
        sh 'npm install'
      }
    }

    stage('Run Tests') {
      steps {
        sh 'npm test'
      }
    }
  }

  post {
    success {
      echo "✅ Build and tests passed!"
    }
    failure {
      echo "❌ Build or tests failed."
    }
  }
}
